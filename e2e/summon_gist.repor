# E2E: `enozunu summon` resolves a gist agent source over real git transport.
#
# A gist source is normally fetched from `https://gist.github.com/<id>.git`.
# These cases exercise the real resolver — clone, exact-revision checkout, HEAD
# verification — against a local git repository instead of a live Gist, by
# redirecting that URL with a workspace-local `GIT_CONFIG_GLOBAL` insteadOf
# rewrite. This keeps the test offline and deterministic while still driving the
# actual git repository access that a fake transport cannot cover.

case "summon materializes the pinned gist revision, not the branch tip" {
  # A local repository standing in for the Gist: an older commit and a newer
  # HEAD, so pinning the older revision proves exact-revision resolution rather
  # than a default-HEAD checkout.
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  $ printf '# shell reviewer OLD\n' > gist-repo/agent.md
  $ git -C gist-repo add agent.md
  $ git -C gist-repo commit --quiet -m old
  $ printf '# shell reviewer NEW\n' > gist-repo/agent.md
  $ git -C gist-repo commit --quiet -am new
  # Redirect the gist remote to the local repository. The rewrite lives in a
  # workspace-local git config so nothing outside the case workspace is touched.
  $ printf '[url "file://%s/gist-repo"]\n\tinsteadOf = https://gist.github.com/2decf6c462d9b4418f2.git\n' "$PWD" > fake-gitconfig
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        agents {
          agent "gist-reviewer" {
            gist {
              id "2decf6c462d9b4418f2"
              revision "PINNED_REVISION"
              file "agent.md"
            }
          }
        }
      }
      consumer {
        claude {
          use-agents "gist-reviewer"
        }
      }
    }
    ```
  # Pin the older commit, which is not the branch tip.
  $ old=$(git -C gist-repo rev-parse HEAD~1) && sed -i "s/PINNED_REVISION/$old/" enozunu.kdl
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 0
    stdout contains "gist: 2decf6c462d9b4418f2@"
    # The materialized file is the older revision's content, proving the exact
    # revision was checked out rather than the branch tip.
    file <".claude/agents/gist-reviewer.md"> contains "shell reviewer OLD"
    not {
      file <".claude/agents/gist-reviewer.md"> contains "shell reviewer NEW"
    }
    file <".enozunu/provenance.json"> contains "\"type\": \"gist\""
  }
}

case "summon reports a gist revision that does not exist" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  $ printf '# shell reviewer\n' > gist-repo/agent.md
  $ git -C gist-repo add agent.md
  $ git -C gist-repo commit --quiet -m only
  $ printf '[url "file://%s/gist-repo"]\n\tinsteadOf = https://gist.github.com/2decf6c462d9b4418f2.git\n' "$PWD" > fake-gitconfig
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        agents {
          agent "gist-reviewer" {
            gist {
              id "2decf6c462d9b4418f2"
              revision "0123456789abcdef0123456789abcdef01234567"
              file "agent.md"
            }
          }
        }
      }
      consumer {
        claude {
          use-agents "gist-reviewer"
        }
      }
    }
    ```
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 1
    # Classification is by diagnostic code, not message text: a fetch that
    # reached the repository but not the pinned revision is gist-revision-not-found.
    stderr contains "gist-revision-not-found"
    not {
      dir <".claude"> exists
    }
  }
}

# The three cases below pin the CLI-visible diagnostics for a gist `file`
# selection that resolves badly. Beyond the diagnostic code, each asserts the
# message prefix naming the artifact kind: the file-shaped checks are shared
# across kinds (issue #38), so a failure must be reported as the entry's actual
# kind rather than a hard-coded `agent`.
#
# The workspace path and the pinned revision are captured as case-local
# bindings and substituted into interpolated `write` literals, so the
# gitconfig and the manifest are written declaratively rather than assembled
# with shell redirection and sed.

case "summon reports a gist file missing from the pinned revision" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  $ printf '# shell reviewer\n' > gist-repo/agent.md
  $ git -C gist-repo add agent.md
  $ git -C gist-repo commit --quiet -m only
  $ pwd
  let workspace <- stdout_line
  $ git -C gist-repo rev-parse HEAD
  let rev <- stdout_line
  write <"fake-gitconfig"> &```
    [url "file://&{workspace}/gist-repo"]
      insteadOf = https://gist.github.com/2decf6c462d9b4418f2.git
    ```
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        agents {
          agent "gist-reviewer" {
            gist {
              id "2decf6c462d9b4418f2"
              revision "&{rev}"
              file "missing.md"
            }
          }
        }
      }
      consumer {
        claude {
          use-agents "gist-reviewer"
        }
      }
    }
    ```
  # Setup sanity: the fake gist repository and the interpolated writes are in
  # place, and no target exists yet, so the post-summon assertions start from a
  # verified state.
  assert {
    file <"gist-repo/agent.md"> exists
    file <"fake-gitconfig"> contains &"[url \"file://&{workspace}/gist-repo\"]"
    file <"enozunu.kdl"> contains &"revision \"&{rev}\""
    not {
      dir <".claude"> exists
    }
  }
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 1
    stderr contains "error[source-path-not-found]: agent `gist-reviewer`: gist file `missing.md` does not exist in the resolved revision"
    not {
      dir <".claude"> exists
    }
  }
}

case "summon reports a gist file that is a directory" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  # Git tracks only files, so the directory-shaped `dir.md` is committed through
  # a file inside it.
  $ mkdir -p gist-repo/dir.md
  $ printf 'inner\n' > gist-repo/dir.md/inner.txt
  $ git -C gist-repo add dir.md
  $ git -C gist-repo commit --quiet -m dir
  $ pwd
  let workspace <- stdout_line
  $ git -C gist-repo rev-parse HEAD
  let rev <- stdout_line
  write <"fake-gitconfig"> &```
    [url "file://&{workspace}/gist-repo"]
      insteadOf = https://gist.github.com/2decf6c462d9b4418f2.git
    ```
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        agents {
          agent "gist-reviewer" {
            gist {
              id "2decf6c462d9b4418f2"
              revision "&{rev}"
              file "dir.md"
            }
          }
        }
      }
      consumer {
        claude {
          use-agents "gist-reviewer"
        }
      }
    }
    ```
  # Setup sanity: the directory-shaped `dir.md` and the interpolated writes are
  # in place, and no target exists yet, so the post-summon assertions start
  # from a verified state.
  assert {
    dir <"gist-repo/dir.md"> exists
    file <"gist-repo/dir.md/inner.txt"> exists
    file <"fake-gitconfig"> contains &"[url \"file://&{workspace}/gist-repo\"]"
    file <"enozunu.kdl"> contains &"revision \"&{rev}\""
    not {
      dir <".claude"> exists
    }
  }
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 1
    stderr contains "error[artifact-shape]: agent `gist-reviewer`: gist file `dir.md` is not a regular file"
    not {
      dir <".claude"> exists
    }
  }
}

case "summon reports a gist file escaping the resolved revision" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  # A committed symlink whose target lies outside the exported content: the
  # workspace-absolute target exists during the run, so path canonicalization
  # succeeds and the containment check is what rejects it.
  $ printf 'outside\n' > outside.txt
  $ ln -s "$PWD/outside.txt" gist-repo/escape.md
  $ git -C gist-repo add escape.md
  $ git -C gist-repo commit --quiet -m escape
  $ pwd
  let workspace <- stdout_line
  $ git -C gist-repo rev-parse HEAD
  let rev <- stdout_line
  write <"fake-gitconfig"> &```
    [url "file://&{workspace}/gist-repo"]
      insteadOf = https://gist.github.com/2decf6c462d9b4418f2.git
    ```
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        agents {
          agent "gist-reviewer" {
            gist {
              id "2decf6c462d9b4418f2"
              revision "&{rev}"
              file "escape.md"
            }
          }
        }
      }
      consumer {
        claude {
          use-agents "gist-reviewer"
        }
      }
    }
    ```
  # Setup sanity: the escape target and the symlink (whose resolution through
  # to the regular file proves it points where intended) and the interpolated
  # writes are in place, and no target exists yet.
  assert {
    file <"outside.txt"> exists
    file <"gist-repo/escape.md"> exists
    file <"fake-gitconfig"> contains &"[url \"file://&{workspace}/gist-repo\"]"
    file <"enozunu.kdl"> contains &"revision \"&{rev}\""
    not {
      dir <".claude"> exists
    }
  }
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 1
    stderr contains "error[unsafe-path]: agent `gist-reviewer`: gist file `escape.md` escapes the resolved revision"
    not {
      dir <".claude"> exists
    }
  }
}
