# E2E: `enozunu summon` generates root repository instruction files.
#
# `provider.instructions.<target>` declares the base document source, and the
# target consumer's `use-skills` selections (with optional `when` annotations)
# become the fixed Skill usage rules. The generated CLAUDE.md / AGENTS.md is
# asserted byte-for-byte with `text_equals`, because the composition contract
# (marker, section separation, trailing LF) is byte-level.

case "summon generates CLAUDE.md from a local base document" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "demo"
        }
      }
    }
    ```
  assert {
    file <"skills/demo/SKILL.md"> exists
    file <"base.md"> exists
    not {
      file <"CLAUDE.md"> exists
    }
  }
  $ enozunu summon
  assert {
    exit 0
    stdout contains "materialized instruction `claude` for claude -> CLAUDE.md"
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - Always use the `demo` skill.
      ```
    file <".claude/skills/demo/SKILL.md"> exists
    file <".enozunu/provenance.json"> contains "\"kind\": \"instruction\""
  }
}

case "summon renders multiple when rules in declaration order" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "demo" {
            when "updating documentation"
            when "writing or modifying code comments"
          }
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - When updating documentation, always use the `demo` skill.
      - When writing or modifying code comments, always use the `demo` skill.
      ```
  }
}

# The next two cases assert the same expected bytes for the grouped form and
# the split form, fixing the issue #38 acceptance criterion that the two
# surface forms generate byte-for-byte identical instructions.

case "grouped use-skills generates the canonical skill usage section" {
  write <"skills/a/SKILL.md"> ```
    # a
    ```
  write <"skills/b/SKILL.md"> ```
    # b
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "a" { local { path "skills/a" } }
          skill "b" { local { path "skills/b" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "a" "b"
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - Always use the `a` skill.
      - Always use the `b` skill.
      ```
  }
}

case "split use-skills generates the same bytes as the grouped form" {
  write <"skills/a/SKILL.md"> ```
    # a
    ```
  write <"skills/b/SKILL.md"> ```
    # b
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "a" { local { path "skills/a" } }
          skill "b" { local { path "skills/b" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "a"
          use-skills "b"
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - Always use the `a` skill.
      - Always use the `b` skill.
      ```
  }
}

case "summon omits the skill usage section when no skill is selected" {
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document
      ```
    not {
      file <"CLAUDE.md"> contains "## Skill usage"
    }
  }
}

case "summon replaces an existing CLAUDE.md whole" {
  write <"base.md"> ```
    # Base document
    ```
  write <"CLAUDE.md"> ```
    hand-written content that must disappear
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  assert {
    file <"CLAUDE.md"> contains "hand-written content that must disappear"
  }
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document
      ```
    not {
      file <"CLAUDE.md"> contains "hand-written content that must disappear"
    }
  }
}

case "summon generates AGENTS.md for codex" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"agents-base.md"> ```
    # Codex base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          codex { local { path "agents-base.md" } }
        }
      }
      consumer {
        codex {
          use-skills "demo"
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    stdout contains "materialized instruction `codex` for codex -> AGENTS.md"
    file <"AGENTS.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Codex base document

      ## Skill usage

      - Always use the `demo` skill.
      ```
    not {
      file <"CLAUDE.md"> exists
    }
  }
}

case "validate rejects when rules without an instruction source" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
      }
      consumer {
        claude {
          use-skills "demo" {
            when "updating documentation"
          }
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "`consumer.claude` declares `when` usage rules, but `provider.instructions.claude` is not declared"
  }
}

case "summon refuses to replace a directory at CLAUDE.md and writes nothing" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"base.md"> ```
    # Base document
    ```
  $ mkdir -p CLAUDE.md
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "demo"
        }
      }
    }
    ```
  assert {
    dir <"CLAUDE.md"> exists
  }
  $ enozunu summon
  assert {
    exit 1
    stderr contains "error[unsafe-path]: instruction `claude`: target path `CLAUDE.md` is a directory"
    # The directory survives and, per the atomicity boundary, no other target is written either.
    dir <"CLAUDE.md"> exists
    not {
      dir <".claude"> exists
    }
  }
}

case "summon fails on a non-UTF-8 base document and writes nothing" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  $ printf '\377\376' > base.md
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          claude { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "demo"
        }
      }
    }
    ```
  assert {
    file <"base.md"> exists
  }
  $ enozunu summon
  assert {
    exit 1
    stderr contains "error[artifact-shape]: instruction `claude`: base document is not valid UTF-8"
    not {
      file <"CLAUDE.md"> exists
    }
    not {
      dir <".claude"> exists
    }
  }
}

case "a mutable instruction git source follows the lockfile" {
  $ git init --quiet --initial-branch main repo
  $ git -C repo config user.email "e2e@example.com"
  $ git -C repo config user.name "e2e"
  write <"repo/base.md"> ```
    # Base document
    ```
  $ git -C repo add base.md
  $ git -C repo commit --quiet -m base
  $ pwd
  let workspace <- stdout_line
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        instructions {
          claude {
            git {
              url "file://&{workspace}/repo"
              branch "main"
              path "base.md"
            }
          }
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    file <"CLAUDE.md"> contains "# Base document"
    file <"enozunu.lock.json"> contains &"\"url\": \"file://&{workspace}/repo\""
    file <"enozunu.lock.json"> contains "\"type\": \"branch\""
  }
  # The recorded revision satisfies frozen mode without re-resolution.
  $ enozunu summon --frozen
  assert {
    exit 0
  }
}

case "an instruction gist failure is reported as instruction, not agent" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  write <"gist-repo/base.md"> ```
    # Base document
    ```
  $ git -C gist-repo add base.md
  $ git -C gist-repo commit --quiet -m base
  $ pwd
  let workspace <- stdout_line
  $ git -C gist-repo rev-parse HEAD
  let rev <- stdout_line
  write <"fake-gitconfig"> &```
    [url "file://&{workspace}/gist-repo"]
      insteadOf = https://gist.github.com/2decf6c462d9b4418f2.git
    ```
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        instructions {
          claude {
            gist {
              id "2decf6c462d9b4418f2"
              revision "&{rev}"
              file "missing.md"
            }
          }
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 1
    stderr contains "error[source-path-not-found]: instruction `claude`: gist file `missing.md` does not exist in the resolved revision"
    not {
      stderr contains "agent `"
    }
    not {
      file <"CLAUDE.md"> exists
    }
  }
}

case "summon generates CLAUDE.md from a gist base document" {
  $ git init --quiet --initial-branch main gist-repo
  $ git -C gist-repo config user.email "e2e@example.com"
  $ git -C gist-repo config user.name "e2e"
  write <"gist-repo/base.md"> ```
    # Gist base document
    ```
  $ git -C gist-repo add base.md
  $ git -C gist-repo commit --quiet -m base
  $ pwd
  let workspace <- stdout_line
  $ git -C gist-repo rev-parse HEAD
  let rev <- stdout_line
  write <"fake-gitconfig"> &```
    [url "file://&{workspace}/gist-repo"]
      insteadOf = https://gist.github.com/2decf6c462d9b4418f2.git
    ```
  write <"enozunu.kdl"> &```
    enozunu config-version=1 {
      provider {
        instructions {
          claude {
            gist {
              id "2decf6c462d9b4418f2"
              revision "&{rev}"
              file "base.md"
            }
          }
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  assert {
    file <"fake-gitconfig"> contains &"[url \"file://&{workspace}/gist-repo\"]"
    file <"enozunu.kdl"> contains &"revision \"&{rev}\""
  }
  $ GIT_CONFIG_GLOBAL="$PWD/fake-gitconfig" GIT_CONFIG_NOSYSTEM=1 enozunu summon
  assert {
    exit 0
    stdout contains "materialized instruction `claude` for claude -> CLAUDE.md (gist: 2decf6c462d9b4418f2@"
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Gist base document
      ```
    file <".enozunu/provenance.json"> contains "\"type\": \"gist\""
  }
}
