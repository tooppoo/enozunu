# E2E: `same-as` reuses one target's manifest value from another target.
#
# `provider.instructions.<target>` and `consumer.<target>.use-skills` can be
# aliased to another target with `same-as`. These cases exercise the two
# happy paths through `enozunu summon` (the reused value must produce the same
# materialized output as a direct declaration) and the CLI-observable
# rejections through `enozunu validate`. Local sources keep the runs offline
# and deterministic.

case "summon reuses one instruction base document for both targets via same-as" {
  write <"base.md"> ```
    # Shared base
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
          codex same-as="provider.instructions.claude"
        }
      }
      consumer {
        claude {}
        codex {}
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    # Codex aliases Claude's instruction source, so both root files are
    # generated from the same base document.
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Shared base
      ```
    file <"AGENTS.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Shared base
      ```
  }
}

case "summon reuses a use-skills selection with when rules for another target via same-as" {
  write <"skills/demo/SKILL.md"> ```
    # demo
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
        instructions {
          claude { local { path "base.md" } }
          codex { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "demo" {
            when "reviewing code"
          }
        }
        codex {
          use-skills same-as="consumer.claude.use-skills"
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    # Codex reuses Claude's normalized selection, so AGENTS.md carries the same
    # when rule and the demo skill materializes into the codex-native path.
    file <"AGENTS.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - When reviewing code, always use the `demo` skill.
      ```
    file <".agents/skills/demo/SKILL.md"> exists
  }
}

case "validate rejects a use-skills same-as alias to an undeclared consumer" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        codex {
          use-skills same-as="consumer.claude.use-skills"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    # Pin the referenced consumer target, not the bare "is not declared"
    # phrase, so the case cannot pass on an unrelated diagnostic.
    stderr contains "`consumer.claude` is not declared"
  }
}

case "validate rejects combining a use-skills same-as alias with a normal selection" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "demo" { local { path "skills/demo" } }
        }
      }
      consumer {
        claude {
          use-skills "demo"
        }
        codex {
          use-skills same-as="consumer.claude.use-skills"
          use-skills "demo"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "must not combine"
  }
}

case "validate rejects an instruction same-as alias chain" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude same-as="provider.instructions.codex"
          codex same-as="provider.instructions.claude"
        }
      }
      consumer {
        claude {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "alias chains are not supported"
  }
}

case "validate rejects an instruction same-as alias to an undeclared target" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          codex same-as="provider.instructions.claude"
        }
      }
      consumer {
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    # Pin the referenced instruction target, not the bare "which is not
    # declared" phrase, so the case asserts the intended diagnostic.
    stderr contains "`provider.instructions.claude`, which is not declared"
  }
}
