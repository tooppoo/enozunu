# E2E: `use-same-*` reuses one target's manifest value from another target.
#
# `use-same-skills` / `use-same-agents` expand the referenced target's
# effective consumer selections at the declaration position, and
# `use-same-instruction` reuses the referenced target's instruction source.
# These cases exercise the happy paths through `enozunu summon`: the reused
# values must produce the same materialized output as direct declarations,
# additively and in declaration order. Local sources keep the runs offline
# and deterministic. The CLI-observable rejections are covered by
# validate_use_same.repor.

case "summon expands use-same-skills additively in declaration order" {
  write <"skills/review/SKILL.md"> ```
    # review
    ```
  write <"skills/codex-only/SKILL.md"> ```
    # codex-only
    ```
  write <"base.md"> ```
    # Base document
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        skills {
          skill "review" { local { path "skills/review" } }
          skill "codex-only" { local { path "skills/codex-only" } }
        }
        instructions {
          claude { local { path "base.md" } }
          codex { local { path "base.md" } }
        }
      }
      consumer {
        claude {
          use-skills "review" {
            when "before completion"
          }
        }
        codex {
          use-same-skills "claude"
          use-skills "codex-only"
          use-skills "review" {
            when "after implementation"
          }
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    # The expansion lands at the use-same-skills position, so Claude's rule
    # comes first; the duplicate selection of `review` keeps both when rules
    # as independent lines while the skill directory materializes once.
    file <"AGENTS.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Base document

      ## Skill usage

      - When before completion, always use the `review` skill.
      - Always use the `codex-only` skill.
      - When after implementation, always use the `review` skill.
      ```
    file <".agents/skills/review/SKILL.md"> exists
    file <".agents/skills/codex-only/SKILL.md"> exists
  }
}

case "summon expands use-same-agents into the referencing target's native path" {
  write <"agents/helper.toml"> ```
    name = "helper"
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        agents {
          agent "helper" { local { path "agents/helper.toml" } }
        }
      }
      consumer {
        claude {
          use-agents "helper"
        }
        codex {
          use-same-agents "claude"
        }
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    # Both targets select the same agent source; each materializes it into its
    # own native path without conversion.
    file <".claude/agents/helper.md"> exists
    file <".codex/agents/helper.toml"> exists
  }
}

case "summon reuses one instruction base document via use-same-instruction" {
  write <"base.md"> ```
    # Shared base
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
          codex {
            use-same-instruction "claude"
          }
        }
      }
      consumer {
        claude {}
        codex {}
      }
    }
    ```
  $ enozunu summon
  assert {
    exit 0
    # Codex reuses Claude's instruction source, so both root files are
    # generated from the same base document.
    file <"CLAUDE.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Shared base
      ```
    file <"AGENTS.md"> text_equals ```
      <!-- Generated by enozunu. Do not edit directly. -->

      # Shared base
      ```
  }
}
