case "validate rejects multiple use-same-instruction nodes in one target" {
  write <"base.md"> ```
    # Base
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
          codex {
            use-same-instruction "claude"
            use-same-instruction "claude"
          }
        }
      }
      consumer {
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "at most one is allowed"
  }
}

case "validate rejects combining use-same-instruction with a source reference block" {
  write <"base.md"> ```
    # Base
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
          codex {
            use-same-instruction "claude"
            local { path "base.md" }
          }
        }
      }
      consumer {
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "must not combine `use-same-instruction` with a source reference block"
  }
}
