        claude {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "`use-same-instruction` under `provider.instructions.claude` must not reference itself"
  }
}

case "validate rejects a use-same-instruction reference cycle" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude {
            use-same-instruction "codex"
          }
          codex {
            use-same-instruction "claude"
          }
        }
