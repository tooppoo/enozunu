# E2E: `enozunu validate` reports `use-same-skills` / `use-same-agents` /
# `use-same-instruction` misuse.
#
# These cases pin the user-visible diagnostic wording for the reference and
# shape rules of `use-same-*` (issue #60) and for the removed legacy `same-as`
# forms (issue #68); the unit tests assert only the diagnostic codes and
# resolved model. Happy-path materialization through `enozunu summon` is
# covered by the summon scenarios.

case "validate rejects the removed use-skills same-as alias with a migration hint" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        claude {
          use-skills same-as="consumer.codex.use-skills"
        }
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    # The removed issue #53 alias must fail with the migration target, not a
    # generic shape error, so released manifests get an actionable message.
    stderr contains "`use-skills same-as` under `consumer.claude` is no longer supported; use `use-same-skills \"<target>\"` instead"
  }
}

case "validate rejects the removed instruction same-as alias with a migration hint" {
  write <"base.md"> ```
    # Base
    ```
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude { local { path "base.md" } }
          codex same-as="provider.instructions.claude"
        }
      }
      consumer {
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    # The removed issue #53 alias must fail with the migration target, not a
    # generic shape error, so released manifests get an actionable message.
    stderr contains "`provider.instructions.codex` `same-as` is no longer supported; declare `use-same-instruction \"<target>\"` inside the target block instead"
  }
}

case "validate rejects use-same-skills referencing an undeclared consumer" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        codex {
          use-same-skills "claude"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    # Pin the referencing node and the referenced consumer target, so the
    # case cannot pass on the legacy same-as diagnostic or an unrelated
    # "is not declared" message.
    stderr contains "`use-same-skills` references `consumer.claude`, but `consumer.claude` is not declared"
  }
}

case "validate rejects a self-referential use-same-skills" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        claude {
          use-same-skills "claude"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "`use-same-skills` under `consumer.claude` must not reference itself"
  }
}

case "validate rejects a use-same-skills reference cycle" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        claude {
          use-same-skills "codex"
        }
        codex {
          use-same-skills "claude"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "forms a reference cycle"
  }
}

case "validate rejects use-same-skills naming an unsupported target" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        claude {
          use-same-skills "gemini"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "references unsupported target `gemini`"
  }
}

case "validate rejects a use-same-skills node with a malformed shape" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      consumer {
        claude {
          use-same-skills "claude" "codex"
        }
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "`use-same-skills` under `consumer.claude` must have exactly one target argument"
  }
}

