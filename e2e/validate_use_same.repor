case "validate rejects use-same-instruction referencing an undeclared target" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          codex {
            use-same-instruction "claude"
          }
        }
      }
      consumer {
        codex {}
      }
    }
    ```
  $ enozunu validate
  assert {
    exit 1
    stderr contains "`provider.instructions.codex` `use-same-instruction` references `provider.instructions.claude`, which is not declared"
  }
}

case "validate rejects a self-referential use-same-instruction" {
  write <"enozunu.kdl"> ```
    enozunu config-version=1 {
      provider {
        instructions {
          claude {
            use-same-instruction "claude"
          }
        }
      }
